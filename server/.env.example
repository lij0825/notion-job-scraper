# 서버 포트
PORT=3000

# Notion OAuth 2.0 Client ID (공개 식별자)
NOTION_CLIENT_ID=your_notion_client_id_here

# Notion OAuth 2.0 Client Secret (서버 전용 비밀 키 — 절대 클라이언트에 노출 금지)
NOTION_CLIENT_SECRET=secret_your_notion_client_secret_here

# Sentry DSN (Serverless 에러 모니터링, Production 환경에서만 활성화됨)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
