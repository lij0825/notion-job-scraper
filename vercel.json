{
	"version": 2,
	"functions": {
		"server/api/token.ts": {
			"maxDuration": 10
		}
	},
	"headers": [
		{
			"source": "/api/(.*)",
			"headers": [
				{
					"key": "Access-Control-Allow-Origin",
					"value": "*"
				},
				{
					"key": "Access-Control-Allow-Methods",
					"value": "POST, OPTIONS"
				},
				{
					"key": "Access-Control-Allow-Headers",
					"value": "Content-Type, Authorization"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/api/token",
			"destination": "/server/api/token.ts"
		}
	]
}
