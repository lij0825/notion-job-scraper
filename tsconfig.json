{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"lib": ["ES2020", "DOM"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"moduleResolution": "node"
	},
	"include": ["api/**/*.ts", "server/**/*.ts"],
	"exclude": ["node_modules", "dist", "extension", "web"]
}
